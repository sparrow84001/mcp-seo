{
  "name": "@sparrow84001/mcp-seo",
  "mcpName": "io.github.sparrow84001/mcp-seo",
  "version": "1.0.4",
  "description": "SEO, AEO, GEO, Local SEO & Digital Marketing Growth Auditor + Safe Code Fixer MCP Server",
  "main": "dist/index.js",
  "module": "src/index.ts",
  "bin": {
    "mcp-seo": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --minify",
    "prepare": "bun build src/index.ts --outdir dist --target node --minify",
    "prepublishOnly": "bun build src/index.ts --outdir dist --target node --minify",
    "compile": "bun build --compile --minify ./src/index.ts --outfile ./bin/mcp-seo.exe",
    "typecheck": "tsc --noEmit",
    "start": "bun run src/index.ts",
    "start:http": "bun run src/index.ts --http",
    "dev": "bun run --watch src/index.ts",
    "dev:http": "bun run --watch src/index.ts --http",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "seo",
    "aeo",
    "geo",
    "local-seo",
    "technical-seo",
    "digital-marketing",
    "conversion-rate-optimization",
    "code-fixer"
  ],
  "author": {
    "name": "Sayanta Neogi",
    "email": "sparrow8400@gmail.com",
    "url": "https://github.com/sparrow84001"
  },
  "homepage": "https://github.com/sparrow84001/mcp-seo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparrow84001/mcp-seo.git"
  },
  "bugs": {
    "url": "https://github.com/sparrow84001/mcp-seo/issues",
    "email": "sparrow8400@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cheerio": "^1.2.0",
    "fast-glob": "^3.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
